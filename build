#!/usr/bin/env bash
set -u

run() {
	"$@" || {
		echo "FAILED: $*" >&2
		exit 1
	}
}

optimize="ReleaseFast"
if [[ "${1:-}" == "debug" || "${1:-}" == "--debug" ]]; then
	optimize="Debug"
	shift
fi

if [[ "$optimize" != "ReleaseFast" ]]; then
	run zig build "-Doptimize=$optimize" "$@"
elif command -v nix >/dev/null 2>&1; then
	run nix build "$@"
	mkdir -p zig-out/bin
	run install -m755 result/bin/* zig-out/bin/
else
	run zig build "-Doptimize=$optimize" "$@"
fi
