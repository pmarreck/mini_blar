.{
    .name = .mini_blar,
    .fingerprint = 0xd8bfbfc79c76bfdf,
    .version = "3.0.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .blip = .{
            .url = "https://github.com/pmarreck/BLIP/archive/refs/tags/v3.1.0.tar.gz",
